# Server Configuration
PORT=3000

# Database Configuration
DATABASE_URL=postgres://username:password@hostname:port/database

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
